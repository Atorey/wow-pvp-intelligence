{
  // Configuración única de todo el monorepo. No hay build de TypeScript:
  // los jobs se ejecutan con tsx directamente sobre el fuente, así que aquí
  // TypeScript solo hace de type-checker (noEmit).
  //
  // apps/web queda fuera y se comprueba con su propio proyecto (ADR 0001):
  // necesita JSX y la librería del DOM, que aquí no pintan nada. Los dos
  // proyectos heredan tsconfig.base.json, así que el rigor es el mismo, y
  // "npm run typecheck" desde la raíz los ejecuta a los dos.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["packages/*/src/**/*.ts", "apps/*/src/**/*.ts"],
  "exclude": ["apps/web"]
}
