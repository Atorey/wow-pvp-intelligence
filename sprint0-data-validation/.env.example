# Copia este archivo como ".env" y rellena con tus credenciales reales.
# Se obtienen creando un client en https://develop.battle.net/access (ver README.md, paso 1).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Región del namespace (sección 30 del plan de producto: lanzamos EU primero)
BLIZZARD_REGION=eu

# Connection string de Postgres/Supabase.
# En Supabase: Project Settings → Database → Connection string → URI.
# Ojo: usa la contraseña de la base de datos (no la de tu cuenta Supabase).
DATABASE_URL=
