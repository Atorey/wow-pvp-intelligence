# Copia este archivo como ".env" en la raíz del repo y rellena los valores.
# El .env real NUNCA se commitea (está en .gitignore).

# --- Blizzard API ---
# Se obtienen creando un client en https://develop.battle.net/access
# (flujo client credentials: no hace falta redirect URI real ni login de usuario).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Región del namespace. Decisión de lanzamiento: EU primero (docs/product-plan.md §25).
BLIZZARD_REGION=eu

# Peticiones por segundo del cliente de ingesta.
# Límite documentado de Blizzard: 100 req/s y 36.000 req/h por client ID.
# Mantenerse muy por debajo es deliberado: el techo real que nos limita es el
# horario (36.000/h ≈ 10 req/s sostenidos), no el instantáneo.
BLIZZARD_REQUESTS_PER_SECOND=8

# --- Base de datos ---
# Postgres. En Supabase: Project Settings → Database → Connection string → URI
# (usa la contraseña de la base de datos, no la de tu cuenta Supabase).
DATABASE_URL=
