# Copia este archivo como ".env" en la raíz del repo y rellena los valores.
# El .env real NUNCA se commitea (está en .gitignore).

# --- Blizzard API ---
# Se obtienen creando un client en https://develop.battle.net/access
# (flujo client credentials: no hace falta redirect URI real ni login de usuario).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Región del namespace. Decisión de lanzamiento: EU primero (docs/product-plan.md §25).
BLIZZARD_REGION=eu

# Ritmo al que se espacia a sí mismo ESTE proceso. No es el techo de nadie más.
# Mantenerse muy por debajo de los 100 req/s de Blizzard es deliberado: el techo
# que nos limita de verdad es el horario, no el instantáneo.
BLIZZARD_REQUESTS_PER_SECOND=8

# --- Presupuesto compartido de cuota (ADR 0013) ---
#
# Desde el ADR 0013 la cuenta no vive en la memoria del proceso sino en Postgres
# (tabla blizzard_quota, dos token buckets). Cualquier proceso —el pipeline, un
# job de Actions, una función de Netlify— pide permiso ahí antes de llamar a
# Blizzard, así que la cuenta es correcta haya un proceso o cien.
#
# Estos tres valores NO viven en la tabla: viajan como parámetro desde aquí, así
# que tienen que valer lo mismo en todos los sitios donde se configuran (este
# .env, los secretos de Actions y las variables del sitio en Netlify). Uno mal
# configurado rellenaría el bucket más rápido de lo que debe.

# Capacidad del bucket compartido por segundo. Real de Blizzard: 100/s.
# Va por debajo porque N invocaciones concurrentes pueden coincidir en el mismo
# segundo sin que ninguna sepa de las otras.
BLIZZARD_GLOBAL_PER_SECOND=80

# Techo horario GLOBAL. Real de Blizzard: 36.000/h por client ID.
# Antes valía 24.000 porque el presupuesto era por proceso y dos jobs solapados
# no se veían; ahora se ven, así que el margen solo tiene que cubrir los
# desfases de reloj entre procesos y lo que no pase por el bucket.
BLIZZARD_REQUESTS_PER_HOUR=32000

# Fichas del bucket horario que solo la búsqueda de usuario puede gastar.
# La prioridad dejó de ser un orden: un proceso efímero no puede esperar turno
# en una cola que no ve, así que ceder el paso se implementa con un colchón que
# el trabajo de fondo no toca. 2.000 son ~330 búsquedas.
BLIZZARD_ON_DEMAND_RESERVE=2000

# Presupuesto de tiempo total de una búsqueda con alguien esperando delante.
# Por debajo de los 10 s a los que Netlify corta la función: agotarlo diciendo
# "ahora mismo no puedo mirarlo" es mejor que agotarlo con un timeout, que desde
# fuera se ve igual que un error.
BLIZZARD_LOOKUP_TIME_BUDGET_MS=8000

# Días que se conservan los JSON descargados en data/leaderboard/.
# Son caché de depuración: el histórico vive en Postgres (append-only), no aquí.
# Sin poda, el job programado cada 3h llena el disco con datos ya ingeridos.
LEADERBOARD_RETENTION_DAYS=3

# Techo de peticiones de una corrida de refresh-profiles (ADR 0021), el job que
# mantiene fresca la base de comparación. A 4 peticiones por personaje son
# ~1.500 perfiles, unos 30 minutos al ritmo real de 3,2 req/s. Es un tope
# declarado, no la cuota: sin él, una corrida diaria pasaría de pedir media hora
# de runner a agotar la ventana horaria según madura la ladder y crece la
# población.
PROFILE_REFRESH_BUDGET=6000

# Minutos que se considera fresco el perfil de un personaje ya consultado, para
# el refresco bajo demanda (§28 del plan pide caché corta, 15-30 min). Sin ella,
# cinco búsquedas seguidas del mismo personaje cuestan cinco veces la cuota y
# meten cinco snapshots casi idénticos en un histórico que mide cambios.
CHARACTER_LOOKUP_TTL_MINUTES=30

# --- Base de datos ---
# Postgres. En Supabase: Project Settings → Database → Connection string → URI
# (usa la contraseña de la base de datos, no la de tu cuenta Supabase).
#
# La lee el pipeline y la lee la web: el buscador consulta población y
# escribe la que trae de Blizzard. En local vale la misma cadena para los dos;
# en Netlify tiene que ser la del pooler (ver más abajo).
DATABASE_URL=

# Base LOCAL y desechable para el test de integración del schema (#64), que la
# trunca antes de sembrarla. Si no está definida, ese test se salta.
#
# Es una variable aparte de DATABASE_URL y no cae de vuelta a ella para que
# `npm test` no pueda vaciar la base con la que estás desarrollando. La misma
# razón por la que `seed` se niega a escribir en nada que no sea localhost.
#
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/wowpvp_test

# --- Web (apps/web) ---
# Origen público del sitio. De él cuelgan los canonical y los hreflang, que se
# escriben como rutas relativas. Sin definir, la app cae a DEPLOY_PRIME_URL (la
# URL real del deploy, que rellena Netlify) y, fuera de Netlify, a
# http://localhost:3000 — así `next dev` funciona sin configurar nada.
#
# En Netlify NO se pone aquí: producción lo trae de netlify.toml y los previews
# se quedan sin él a propósito, para que no se anuncien como producción.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# En Netlify, además, hacen falta como variables del sitio (no en este archivo):
#
#   DATABASE_URL   la cadena del POOLER de Supabase en modo transacción, no la
#                  directa: cada invocación es un proceso y Postgres tiene menos
#                  conexiones que invocaciones concurrentes puede levantar
#                  Netlify (ADR 0013, decisión 10).
#
#   BLIZZARD_CLIENT_ID / BLIZZARD_CLIENT_SECRET
#                  y los cuatro valores del presupuesto compartido de arriba,
#                  con EXACTAMENTE los mismos números que aquí: son el mismo
#                  bucket, y un proceso que crea que la capacidad es otra lo
#                  rellena a otro ritmo.
#
# Cuidado con los deploy previews: ejecutan funciones reales. O apuntan a la
# misma base que producción, o usan un client ID propio. Un preview con el
# client ID de producción y otra base gasta cuota que nadie está contando
# (ADR 0013, decisión 9).
